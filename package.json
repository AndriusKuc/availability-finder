{
  "name": "availability-finder",
  "version": "1.0.0",
  "description": "Team scheduling tool for finding optimal meeting dates",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andriuskuc/availability-finder.git"
  },
  "author": "andriuskuc",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/andriuskuc/availability-finder/issues"
  },
  "homepage": "https://github.com/andriuskuc/availability-finder#readme",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build": "npm run build:client && npm run build:server",
    "build:server": "cd server && npm run build",
    "build:client": "cd client && npm run build",
    "start": "cd server && npm start",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
